# Copy this file to .env for local development. System environment variables
# always have priority over this file.
SERVER_PORT=8080
DATABASE_URL=postgres://playlist:playlist@localhost:5432/playlist?sslmode=disable
LOG_LEVEL=info
DB_MAX_CONNECTIONS=10
HTTP_TIMEOUT=5s
DB_OPERATION_TIMEOUT=3s
DB_CONNECT_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s

# Used by compose.yaml when PostgreSQL is started locally.
POSTGRES_DB=playlist
POSTGRES_USER=playlist
POSTGRES_PASSWORD=playlist
